FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_CLOUDINARY_CLOUD_NAME=dx4aoiw5u
ARG VITE_CLOUDINARY_HERO_CLOUD_NAME
ARG VITE_PROFILE_PHOTO_URL
ARG VITE_CLOUDINARY_HERO_ID
ARG VITE_CONTACT_EMAIL=marcus@example.com
ENV VITE_CLOUDINARY_CLOUD_NAME=$VITE_CLOUDINARY_CLOUD_NAME
ENV VITE_CLOUDINARY_HERO_CLOUD_NAME=$VITE_CLOUDINARY_HERO_CLOUD_NAME
ENV VITE_PROFILE_PHOTO_URL=$VITE_PROFILE_PHOTO_URL
ENV VITE_CLOUDINARY_HERO_ID=$VITE_CLOUDINARY_HERO_ID
ENV VITE_CONTACT_EMAIL=$VITE_CONTACT_EMAIL
RUN npm run build

FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
